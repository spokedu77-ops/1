import { NextResponse } from 'next/server';
import { getServiceSupabase, requireAdmin } from '@/app/lib/server/adminAuth';
import { withPrivateNoStore } from '@/app/lib/server/privateNoStore';
import { readAllMasterAdminIdRows, readAllMasterAdminPages } from '@/app/lib/server/spokeduMasterAdminRead';
export const dynamic='force-dynamic';
type Event={id:string;at:string;type:string;userId:string|null;email:string|null;plan:string|null;change:string;actor:string|null;reason:string|null};
export async function GET(request:Request){const auth=await requireAdmin();if(!auth.ok)return withPrivateNoStore(auth.response);try{const url=new URL(request.url),page=Math.max(1,Number(url.searchParams.get('page')??1)||1),q=(url.searchParams.get('q')??'').trim().toLowerCase(),type=url.searchParams.get('type')??'all',service=getServiceSupabase();const [grants,invites]=await Promise.all([readAllMasterAdminPages<any>({fetchPage:async(p,size)=>{const from=(p-1)*size,r=await service.from('spokedu_master_entitlement_grants').select('id,user_id,plan,created_at,revoked_at,granted_by,metadata,starts_at,ends_at').order('created_at',{ascending:false}).order('id',{ascending:false}).range(from,from+size-1);if(r.error)throw r.error;return r.data??[];}}),readAllMasterAdminPages<any>({fetchPage:async(p,size)=>{const from=(p-1)*size,r=await service.from('spokedu_master_promotion_invites').select('id,email,plan,created_at,created_by,redeemed_at,redeemed_by,revoked_at,campaign_id').order('created_at',{ascending:false}).order('id',{ascending:false}).range(from,from+size-1);if(r.error)throw r.error;return r.data??[];}})]);const events:Event[]=[];for(const g of grants){events.push({id:g.id+':grant',at:g.created_at,type:'grant',userId:g.user_id,email:null,plan:g.plan,change:`${g.starts_at} → ${g.ends_at}`,actor:g.granted_by,reason:g.metadata?.reason??null});for(const [index,x] of (Array.isArray(g.metadata?.extension_history)?g.metadata.extension_history:[]).entries())if(x?.extended_at)events.push({id:g.id+':extend:'+index,at:x.extended_at,type:'extend',userId:g.user_id,email:null,plan:g.plan,change:`${x.old_ends_at??'기록 없음'} → ${x.new_ends_at??g.ends_at}`,actor:x.extended_by??null,reason:x.reason??null});if(g.revoked_at)events.push({id:g.id+':revoke',at:g.revoked_at,type:'revoke',userId:g.user_id,email:null,plan:g.plan,change:'이용권 회수',actor:g.metadata?.revoked_by??null,reason:g.metadata?.revoke_reason??null});}for(const i of invites){events.push({id:i.id+':invite',at:i.created_at,type:'invite_created',userId:null,email:i.email,plan:i.plan,change:'초대권 발급',actor:i.created_by,reason:i.campaign_id});if(i.redeemed_at)events.push({id:i.id+':redeem',at:i.redeemed_at,type:'invite_redeemed',userId:i.redeemed_by,email:i.email,plan:i.plan,change:'초대권 사용',actor:i.redeemed_by,reason:null});if(i.revoked_at)events.push({id:i.id+':cancel',at:i.revoked_at,type:'invite_revoked',userId:null,email:i.email,plan:i.plan,change:'초대권 취소',actor:null,reason:null});}const uniqueEvents=[...new Map(events.map(event=>[event.id,event])).values()];const ids=[...new Set(uniqueEvents.map(e=>e.userId).filter(Boolean))] as string[];const [profiles,authUsers]=await Promise.all([ids.length?readAllMasterAdminIdRows<any>({ids,fetchPage:async(batch,from,to)=>{const r=await service.from('spokedu_master_profiles').select('user_id,name').in('user_id',batch).order('user_id',{ascending:true}).range(from,to);if(r.error)throw r.error;return r.data??[];}}):[],q?readAllMasterAdminPages<any>({fetchPage:async(p,size)=>{const r=await service.auth.admin.listUsers({page:p,perPage:size});if(r.error)throw r.error;return r.data.users;}}):Promise.all(ids.map(async id=>{const r=await service.auth.admin.getUserById(id);if(r.error)throw r.error;return r.data.user;}))]);const names=new Map(profiles.map((x:any)=>[x.user_id,x.name])),users=new Map(authUsers.filter(Boolean).map((x:any)=>[x.id,x]));const enriched=uniqueEvents.map(e=>({...e,name:e.userId?names.get(e.userId)??null:null,email:e.email??(e.userId?users.get(e.userId)?.email??null:null)})).filter(e=>type==='all'||e.type===type).filter(e=>!q||String(e.name??'').toLowerCase().includes(q)||String(e.email??'').toLowerCase().includes(q));enriched.sort((a,b)=>Date.parse(b.at)-Date.parse(a.at)||b.id.localeCompare(a.id));const total=enriched.length,rows=enriched.slice((page-1)*20,page*20);return withPrivateNoStore(NextResponse.json({events:rows,total,page,pageSize:20}));}catch{return withPrivateNoStore(NextResponse.json({error:'작업 이력을 불러오지 못했습니다.'},{status:500}));}}
