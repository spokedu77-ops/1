  { id: 'confidence', label: '운동 자신감' },
  { id: 'fundamental', label: '기초체력·움직임' },
  { id: 'sport-prep', label: '종목 준비' },
  { id: 'peer-group', label: '또래 협동' },
] as const satisfies ReadonlyArray<{ id: PrivateStartDirection; label: string }>;

