# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
playwright-report/
test-results/
blob-report/
.vitest/
.turbo/
.cache/

# SPOKEDU QA artifacts
qa-artifacts/
qa-screenshots/
.qa-screenshots/
.qa-spokedu/
.qa-spokedu-v*/

# Temporary local artifacts
.tmp/
/tmp/
# High-res bake originals (web derivatives only go to public/)
/assets-source/**
!/assets-source/README.md
# (Home field editorial staging → docs/spokedu/HOME_FIELD_EDITORIAL_ASSETS.md + public/images/spokedu/home/field-editorial/)
/docs/*.generated.csv
/commercial-verification/*.json

# dev server logs (local only)
.next-dev.log
.next-dev.err.log

# Generated PDF page renders
scripts/pdf-pages/page-*.png

# next.js
/.next/
/out/

# production
/build

# Local/test Unity WebGL builds (production theme2 remains tracked)
/public/spomove/dive/unity/player_release_test/
/public/spomove/dive/unity/theme2_backup_*/
/public/spomove/dive/unity/theme2_camera_test/
/public/spomove/dive/unity/theme2_session_test/
/public/spomove/dive/unity/*_test/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/debug.log
tsc-out.txt
.eslintcache
eslint-report.json
.cursor/debug*.log

# local agent settings (do not commit API keys in allow rules)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# Supabase CLI local state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
